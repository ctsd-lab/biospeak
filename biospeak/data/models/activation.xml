<?xml version='1.0' encoding='utf-8'?>
<sbml xmlns="http://www.sbml.org/sbml/level3/version2/core" xmlns:html="http://www.w3.org/1999/xhtml" xmlns:math="http://www.w3.org/1998/Math/MathML" level="3" version="2">
  <model id="activation" timeUnits="second" substanceUnits="item" extentUnits="item">
    <notes>
      <html:body>Independent reference export of reaction templates. One volume unit. Concentration coordinates are arbitrary reference units, not calibrated molarity.</html:body>
    </notes>
    <listOfCompartments>
      <compartment id="cell" size="1" spatialDimensions="0" constant="true" />
    </listOfCompartments>
    <listOfSpecies>
      <species id="A" name="A" compartment="cell" initialAmount="0.01" hasOnlySubstanceUnits="true" boundaryCondition="true" constant="false" />
      <species id="D0" name="D0" compartment="cell" initialAmount="1" hasOnlySubstanceUnits="true" boundaryCondition="false" constant="false" />
      <species id="D1" name="D1" compartment="cell" initialAmount="0" hasOnlySubstanceUnits="true" boundaryCondition="false" constant="false" />
      <species id="m" name="m" compartment="cell" initialAmount="0" hasOnlySubstanceUnits="true" boundaryCondition="false" constant="false" />
      <species id="P" name="P" compartment="cell" initialAmount="0" hasOnlySubstanceUnits="true" boundaryCondition="false" constant="false" />
    </listOfSpecies>
    <listOfParameters>
      <parameter id="kb_A" value="0.2" constant="true" />
      <parameter id="ku_A" value="0.001" constant="true" />
      <parameter id="tx_D0" value="0.001" constant="true" />
      <parameter id="tx_D1" value="0.051000000000000004" constant="true" />
      <parameter id="ktl" value="0.05" constant="true" />
      <parameter id="dm" value="0.01" constant="true" />
      <parameter id="dp" value="0.001" constant="true" />
    </listOfParameters>
    <listOfReactions>
      <reaction id="bindA_f" reversible="false">
        <listOfReactants>
          <speciesReference species="A" stoichiometry="1" constant="true" />
          <speciesReference species="D0" stoichiometry="1" constant="true" />
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="D1" stoichiometry="1" constant="true" />
        </listOfProducts>
        <kineticLaw>
          <math:math>
            <math:apply>
              <math:times />
              <math:ci>A</math:ci>
              <math:ci>D0</math:ci>
              <math:ci>kb_A</math:ci>
            </math:apply>
          </math:math>
        </kineticLaw>
      </reaction>
      <reaction id="bindA_r" reversible="false">
        <listOfReactants>
          <speciesReference species="D1" stoichiometry="1" constant="true" />
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="A" stoichiometry="1" constant="true" />
          <speciesReference species="D0" stoichiometry="1" constant="true" />
        </listOfProducts>
        <kineticLaw>
          <math:math>
            <math:apply>
              <math:times />
              <math:ci>D1</math:ci>
              <math:ci>ku_A</math:ci>
            </math:apply>
          </math:math>
        </kineticLaw>
      </reaction>
      <reaction id="tx_D0" reversible="false">
        <listOfReactants>
          <speciesReference species="D0" stoichiometry="1" constant="true" />
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="D0" stoichiometry="1" constant="true" />
          <speciesReference species="m" stoichiometry="1" constant="true" />
        </listOfProducts>
        <kineticLaw>
          <math:math>
            <math:apply>
              <math:times />
              <math:ci>D0</math:ci>
              <math:ci>tx_D0</math:ci>
            </math:apply>
          </math:math>
        </kineticLaw>
      </reaction>
      <reaction id="tx_D1" reversible="false">
        <listOfReactants>
          <speciesReference species="D1" stoichiometry="1" constant="true" />
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="D1" stoichiometry="1" constant="true" />
          <speciesReference species="m" stoichiometry="1" constant="true" />
        </listOfProducts>
        <kineticLaw>
          <math:math>
            <math:apply>
              <math:times />
              <math:ci>D1</math:ci>
              <math:ci>tx_D1</math:ci>
            </math:apply>
          </math:math>
        </kineticLaw>
      </reaction>
      <reaction id="tl_m" reversible="false">
        <listOfReactants>
          <speciesReference species="m" stoichiometry="1" constant="true" />
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="m" stoichiometry="1" constant="true" />
          <speciesReference species="P" stoichiometry="1" constant="true" />
        </listOfProducts>
        <kineticLaw>
          <math:math>
            <math:apply>
              <math:times />
              <math:ci>ktl</math:ci>
              <math:ci>m</math:ci>
            </math:apply>
          </math:math>
        </kineticLaw>
      </reaction>
      <reaction id="decay_m" reversible="false">
        <listOfReactants>
          <speciesReference species="m" stoichiometry="1" constant="true" />
        </listOfReactants>
        <kineticLaw>
          <math:math>
            <math:apply>
              <math:times />
              <math:ci>dm</math:ci>
              <math:ci>m</math:ci>
            </math:apply>
          </math:math>
        </kineticLaw>
      </reaction>
      <reaction id="decay_P" reversible="false">
        <listOfReactants>
          <speciesReference species="P" stoichiometry="1" constant="true" />
        </listOfReactants>
        <kineticLaw>
          <math:math>
            <math:apply>
              <math:times />
              <math:ci>P</math:ci>
              <math:ci>dp</math:ci>
            </math:apply>
          </math:math>
        </kineticLaw>
      </reaction>
    </listOfReactions>
  </model>
</sbml>